--- a/FrontEnd/Dockerfile.prod
+++ b/FrontEnd/Dockerfile.prod
@@ -29,8 +29,8 @@ COPY --from=deps /app/node_modules ./node_modules
 COPY . .
 
 ARG INTERNAL_SERVER_SIDE_API_URL=http://backend:8080
-ARG NEXT_PUBLIC_SITE_URL=https://lucaloupe.ir
-ARG NEXT_PUBLIC_SITE_NAME=Luca
+ARG NEXT_PUBLIC_SITE_URL=https://lucaloupe.ir
+ARG NEXT_PUBLIC_SITE_NAME=Luca Loupe
 ENV INTERNAL_SERVER_SIDE_API_URL=$INTERNAL_SERVER_SIDE_API_URL
 ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
 ENV NEXT_PUBLIC_SITE_NAME=$NEXT_PUBLIC_SITE_NAME
