From 4ad30fbe67efc161d568a1b03feb64e445680d17 Mon Sep 17 00:00:00 2001
From: root <root@srv9280351549.bitcommand.net>
Date: Wed, 14 Oct 2026 12:50:09 +0000
Subject: [PATCH] fix(ci): deploy to the luca server with luca-only images

- main.yml: push images as luca-frontend / luca-backend (no longer shared
  with Luca's shop-* repos)
- main.yml: deploy into /opt/luca-prod instead of /opt/shop
- main.yml: add workflow_dispatch (all|frontend|backend) for the first
  full deploy or a rebuild without code changes; paths-filter v2 -> v3
- Dockerfile.prod: default site URL/name to lucaloupe.ir / Luca Loupe
- docs: drop candyRose, /opt/luca-prod and the Luca VPS IP

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .github/workflows/main.yml | 47 ++++++++++++++++++++++++++++++++------
 FrontEnd/Dockerfile.prod   |  4 ++--
 ROADMAP.md                 |  2 +-
 USER_TODO.md               |  8 +++----
 deploy.sh                  |  8 +++----
 5 files changed, 51 insertions(+), 18 deletions(-)

diff --git a/.github/workflows/main.yml b/.github/workflows/main.yml
index fca4d98..21397db 100644
--- a/.github/workflows/main.yml
+++ b/.github/workflows/main.yml
@@ -5,22 +5,55 @@ on:
     branches:
       - master
 
+  # Manual build + deploy (e.g. first deploy, or rebuild without a code change)
+  workflow_dispatch:
+    inputs:
+      target:
+        description: "What to build & deploy"
+        required: true
+        type: choice
+        options:
+          - all
+          - frontend
+          - backend
+        default: all
+
 jobs:
   detect-changes:
     runs-on: ubuntu-latest
     outputs:
-      frontend: ${{ steps.filter.outputs.frontend }}
-      backend: ${{ steps.filter.outputs.backend }}
+      frontend: ${{ steps.result.outputs.frontend }}
+      backend: ${{ steps.result.outputs.backend }}
     steps:
       - uses: actions/checkout@v4
-      - uses: dorny/paths-filter@v2
+        if: github.event_name == 'push'
+      - uses: dorny/paths-filter@v3
         id: filter
+        if: github.event_name == 'push'
         with:
           filters: |
             frontend:
               - 'FrontEnd/**'
             backend:
               - 'BackEnd/**'
+      - name: Resolve targets
+        id: result
+        shell: bash
+        run: |
+          set -euo pipefail
+          if [[ "${{ github.event_name }}" == "workflow_dispatch" ]]; then
+            case "${{ inputs.target }}" in
+              all)      FE=true;  BE=true  ;;
+              frontend) FE=true;  BE=false ;;
+              backend)  FE=false; BE=true  ;;
+            esac
+          else
+            FE="${{ steps.filter.outputs.frontend }}"
+            BE="${{ steps.filter.outputs.backend }}"
+          fi
+          echo "frontend=${FE}" >> "$GITHUB_OUTPUT"
+          echo "backend=${BE}" >> "$GITHUB_OUTPUT"
+          echo "Resolved frontend=${FE} backend=${BE}"
 
   build-frontend:
     needs: detect-changes
@@ -39,7 +72,7 @@ jobs:
           file: ./FrontEnd/Dockerfile.prod
           push: true
           tags: |
-            ${{ secrets.DOCKER_USERNAME }}/shop-frontend:${{ github.sha }}
+            ${{ secrets.DOCKER_USERNAME }}/luca-frontend:${{ github.sha }}
           build-args: |
             NEXT_PUBLIC_SITE_URL=https://lucaloupe.ir
             NEXT_PUBLIC_SITE_NAME=Luca Loupe
@@ -66,7 +99,7 @@ jobs:
           file: ./BackEnd/Dockerfile.prod
           push: true
           tags: |
-            ${{ secrets.DOCKER_USERNAME }}/shop-backend:${{ github.sha }}
+            ${{ secrets.DOCKER_USERNAME }}/luca-backend:${{ github.sha }}
           cache-from: type=gha
           cache-to: type=gha,mode=max
           provenance: false
@@ -104,9 +137,9 @@ jobs:
           port: ${{ secrets.VPS_PORT }}
           script: |
             set -euo pipefail
-            cd /opt/shop
+            cd /opt/luca-prod
 
-            # Keep infra (candyRose) current before pulling new app images
+            # Keep infra (luca-prod) current before pulling new app images
             git fetch --all --prune
             git pull --ff-only origin master || true
 
