prefix_rule(pattern=["C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "Get-Content FrontEnd/postcss.config.mjs,FrontEnd/tailwind.config.ts; Test-Path FrontEnd/node_modules"], decision="allow")
prefix_rule(pattern=["C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$c=Get-Content FrontEnd/style/globals.css; $c[0..99]; $c[1413..1459]; $c[1474..1547]"], decision="allow")
prefix_rule(pattern=["rg", "-n", "F8F8F8|--primary-foreground|contrastColor|pc-options|pc-chip|ProductCardSkeleton|DetailedProductCard", "FrontEnd"], decision="allow")
