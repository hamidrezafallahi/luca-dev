prefix_rule(pattern=["node", "-e", "const fs=require('node:fs'); const postcss=require('postcss'); postcss([require('tailwindcss'), require('./postcss/font-scale.cjs')]).process(fs.readFileSync('style/globals.css','utf8'),{from:'style/globals.css'}).then(({css})=>{for(const snippet of ['min-height: 2lh','min-height: 2.5rem','var(--store-surface-muted)','--store-surface-solid','calc(14px * var(--text-scale, 1))','calc(500 + var(--weight-shift, 0))','var(--heading-scale, 1)','var(--heading-weight-shift, 0)']){if(!css.includes(snippet)) throw Error('Missing '+snippet)} console.log('Theme and typography CSS checks passed')}).catch(e=>{console.error(e);process.exitCode=1})"], decision="allow")
prefix_rule(pattern=["Get-Content", "FrontEnd/components/molecules/variantPicker/index.tsx"], decision="allow")
