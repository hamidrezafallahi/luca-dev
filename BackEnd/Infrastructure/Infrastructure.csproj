<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.105.1" />
		<PackageReference Include="Hangfire.AspNetCore" Version="1.8.21" />
		<PackageReference Include="Hangfire.Core" Version="1.8.21" />
		<PackageReference Include="Hangfire.PostgreSql" Version="1.9.2" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
	</ItemGroup>

	<!--
		SixLabors.ImageSharp 3.1.11 advisories that this code cannot reach. Every version that fixes them
		(3.2.0, 4.1.2 and later) fails a Release build without a Six Labors licence key, so the pin stays at
		3.1.11 until there is one; drop this list when upgrading. Api.csproj and Application.Tests.csproj get
		ImageSharp through this project and repeat the list.
		- GHSA-j3p4-wp97-rph4 (high): HistogramEqualization processor, never used.
		- GHSA-j9gm-c75j-xc9q, GHSA-jjfr-hcj7-qf5w (high): TIFF CCITT T4/T6 encoders; nothing is saved as TIFF.
		- GHSA-gwg2-r3hj-4w44 (moderate): ICC CLUT parsing, reached in 3.x only through IccProfile.Entries,
		  which neither this code nor the JPEG/PNG/WebP codecs read.
		- GHSA-wmxv-xphr-5c9g (moderate): BigTIFF decoder loop; UploaderService decodes only JPEG, PNG and WebP.
	-->
	<ItemGroup>
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Application\Application.csproj" />
		<ProjectReference Include="..\Domain\Domain.csproj" />
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
</Project>
